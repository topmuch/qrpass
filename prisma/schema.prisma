// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model - supports superadmin, admin, agent, and agency users
model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  password        String?
  role            String        @default("agency") // "superadmin" | "admin" | "agent" | "agency"
  agencyId        String?
  agency          Agency?       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  sessions        Session[]
  loginLogs       LoginLog[]
  assignedLeads   Lead[]        @relation("AssignedLeads")
  observations    Observation[]
  dailyReports    DailyReport[]
  blogPosts       BlogPost[]
  pilgrims        Pilgrim[]     // Pass Identity — pilgrim bracelets owned by this user
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Session model - secure HTTP-only cookie based sessions
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?  // Browser identification
  ipAddress    String?  // IP address at login
  lastActivity DateTime @default(now()) // Last activity timestamp
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// LoginLog model - audit trail for all login attempts
model LoginLog {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String    // Email used for login attempt
  success      Boolean   @default(false) // Whether login succeeded
  failureReason String?  // Reason for failure if applicable
  ipAddress    String?   // IP address
  userAgent    String?   // Browser/client info
  country      String?   // Country from IP
  city         String?   // City from IP
  createdAt    DateTime  @default(now())
}

// Agency model - pilgrimage agencies
model Agency {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  email     String?
  phone     String?
  address   String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  baggages     Baggage[]
  pilgrims     Pilgrim[]
  users        User[]
  invoices     Invoice[]
  trips        Trip[]
  groups       PilgrimGroup[]
  bags         Bag[]
}

// Baggage model - main entity for luggage tracking
model Baggage {
  id                String    @id @default(cuid())
  reference         String    @unique // HAJJ26-MLQGY7, VOL26-K9X2P4
  type              String    // "hajj" or "voyageur"
  setId             String?   // Groups QR codes together (e.g., SET-2026-0966)
  agencyId          String?
  travelerFirstName String?
  travelerLastName  String?
  whatsappOwner     String?
  baggageIndex      Int       @default(1) // 1, 2, 3 (order: 1 = cabine)
  baggageType       String    @default("cabine") // "cabine" or "soute"
  status            String    @default("pending_activation") // pending_activation, active, scanned, lost, found, blocked

  // TRANSPORT-FEATURE: Multi-context transport mode (flight/train/boat/bus)
  transportMode     String    @default("flight") // "flight" | "train" | "boat" | "bus"

  // Flight-specific fields (transportMode = "flight")
  airlineName       String?   // ex: "Air France", "Royal Air Maroc"
  flightNumber      String?

  // Train-specific fields (transportMode = "train")
  trainCompany      String?   // ex: "SNCF", "Renfe", "ONCF"
  trainNumber       String?   // ex: "TGV 6123"

  // Boat-specific fields (transportMode = "boat")
  shipName          String?   // ex: "MSC Fantasia"
  shipCabin         String?   // ex: "Pont 4, Cabine 312"

  // Bus-specific fields (transportMode = "bus")
  busCompany        String?   // ex: "CTM", "Supratours"
  busLineNumber     String?   // ex: "Ligne 45", "Casablanca → Marrakech"

  // Universal fields (all modes)
  destination       String?
  departureDate     DateTime? // Date de départ saisie lors de l'activation
  departureTime     String?   // Heure de départ saisie lors de l'activation (ex: "08:30")

  // Hotel/Accommodation (for Hajj — where to return the baggage)
  hotelName         String?   // ex: "Al Massa Grand Hotel"
  hotelAddress      String?   // ex: "Ibrahim Al Jafri Street, Mecca"
  hotelPhone        String?   // ex: "+966 12 557 0000"
  roomNumber        String?   // ex: "412"

  createdAt         DateTime  @default(now())
  expiresAt         DateTime?
  lastScanDate      DateTime?
  lastLocation      String?
  declaredLostAt    DateTime? // Timestamp when baggage was declared lost
  foundAt           DateTime? // Timestamp when baggage was found
  // Founder information (person who found the baggage)
  founderName       String?   // Name of the finder
  founderPhone      String?   // WhatsApp number of the finder
  founderAt         DateTime? // Timestamp when founder info was submitted
  photoUrl          String?   // URL of the baggage photo uploaded during activation
  agency            Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  scanLogs          ScanLog[]
}

// ScanLog model - tracks all scans for audit
model ScanLog {
  id          String   @id @default(cuid())
  baggageId   String
  ipAddress   String?
  country     String?
  city        String?
  latitude    Float?
  longitude   Float?
  location    String?  // Selected location (Jeddah, Médine, etc.)
  message     String?  // Optional message from finder
  createdAt   DateTime @default(now())
  baggage     Baggage  @relation(fields: [baggageId], references: [id], onDelete: Cascade)

  // ─── Champs IA (Groq) ───
  whatsappStatus  String?   // "sent" | "delivered" | "failed" | "fallback" | "queued" | "read"
  aiAnalysis      Json?     // ScanAIAnalysis: { type, color, size, confidence, isDuplicate, description?, analyzedAt }
  groqUsed        Boolean   @default(false) // true si Groq a été utilisé pour ce scan
  groqLatencyMs   Int?      // Temps de réponse Groq en ms
  aiMessageUsed   Boolean   @default(false) // true si le message WhatsApp a été généré par IA
  groqModelUsed   String?   // Modèle Groq utilisé (ex: "llama-3.3-70b-versatile")
  wakitMessageId  String?   // ID de retour Wakit pour tracking croisé

  // ─── Contexte du scan ───
  context     String?   // "departure_airport_urgent" | "arrival_airport" | "in_transit" | "static_location"
  finderName  String?   // Nom du trouveur (dupliqué ici pour l'API suivi)
  finderPhone String?   // Téléphone du trouveur (dupliqué ici pour l'API suivi)
}

// Settings model - system configuration
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Page model - CMS pages
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   // HTML or Markdown content
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Banner model - dashboard announcements
model Banner {
  id        String   @id @default(cuid())
  type      String   // "header" or "footer"
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// FeatureFlag model - modular feature toggles
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // ex: "whatsapp_automated"
  label       String   // "Envoi WhatsApp automatisé"
  description String   // Clear description for admins
  category    String   @default("general") // "communication", "geolocation", "export", "notifications"
  enabled     Boolean  @default(false)
  icon        String?  // Icon name for UI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Message model - contact, partner requests, agency orders, assistance
// Message types:
// - "contact": Contact form from public website
// - "partenaire": Partner registration requests
// - "commande_agence": QR code orders from agencies
// - "assistance_agence": Support messages from agencies to superadmin
// - "reponse_assistance": Replies from superadmin to agencies
// - "message_superadmin": Messages initiated by superadmin for specific agencies
model Message {
  id          String   @id @default(cuid())
  type        String   // "contact", "partenaire", "commande_agence", "assistance_agence", "reponse_assistance", "message_superadmin"
  status      String   @default("non_lu") // "non_lu", "lu", "traite"
  senderName  String?
  senderEmail String?
  senderPhone String?
  agencyId    String?  // lien vers Agence (si commande agence ou assistance)
  recipientAgencyId String? // Pour les messages du superadmin vers une agence spécifique
  subject     String?  // Subject line for assistance messages
  content     String   // JSON ou texte brut
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Notification model - real-time alerts for SuperAdmin
// Notification types:
// - "baggage_declared_lost": Agency declared a baggage as lost
// - "baggage_found": Lost baggage was found
// - "new_assistance_message": New assistance message from agency
// - "urgent_scan": Urgent scan on lost baggage
model Notification {
  id          String   @id @default(cuid())
  type        String   // "baggage_declared_lost", "baggage_found", "new_assistance_message", "urgent_scan"
  userId      String?  // null = broadcast to all superadmins
  agencyId    String?  // Reference to agency if applicable
  baggageId   String?  // Reference to baggage if applicable
  message     String   // Notification message
  data        String?  // JSON additional data
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// EmailSettings model - SMTP configuration
model EmailSettings {
  id              String   @id @default(cuid())
  provider        String   @default("console") // "console" or "smtp"
  fromEmail       String   @default("noreply@qrpass.com")
  fromName        String   @default("QRPass")
  recipientEmail  String?  // Destination for admin notification emails
  // SMTP settings
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPassword    String?
  smtpEncryption  String   @default("tls") // "tls", "ssl", "none"
  // Status
  isActive        Boolean  @default(true)
  lastTestAt      DateTime?
  lastTestStatus  String?  // "success", "failed"
  lastTestError   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// EmailLog model - tracks all sent emails
model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  type        String   // "verification", "password_reset", "notification", "invoice", "test", "welcome"
  status      String   @default("pending") // "pending", "sent", "failed"
  error       String?
  userId      String?
  agencyId    String?
  data        String?  // JSON for additional data
  sentAt      DateTime?
  createdAt   DateTime @default(now())
}

// EmailToken model - for email verification and password reset
model EmailToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  type      String   // "email_verification", "password_reset"
  code      String?  // 6-digit code for verification
  expiresAt DateTime
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// Invoice model - for agency billing
model Invoice {
  id            String   @id @default(cuid())
  number        String   @unique
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  amount        Float
  currency      String   @default("EUR")
  status        String   @default("pending") // "pending", "paid", "cancelled"
  description   String?
  items         String   // JSON array of invoice items
  dueDate       DateTime?
  paidAt        DateTime?
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Lead model - CRM leads/prospects
model Lead {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String?
  company       String?
  status        String        @default("new") // "new", "contacted", "in_discussion", "qualified", "converted", "lost"
  source        String?       // "website", "referral", "social", "event", "other"
  notes         String?
  agencyId      String?       // Link to agency if converted
  assignedToId  String?       // Agent assigned to this lead
  assignedTo    User?         @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  observations  Observation[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Observation model - tracks interactions with leads
model Observation {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // "note", "rdv", "appel", "email", "whatsapp"
  content   String   // Observation content
  date      DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// DailyReport model - agent daily activity reports
model DailyReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  content   String   // Free text report
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// Advertisement model - promotional banners for agencies
model Advertisement {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String   // URL to banner image
  linkUrl     String?  // Click destination URL
  linkTarget  String   @default("_blank") // "_blank" or "_self"
  
  // Position - only footer
  position    String   @default("footer") // "footer", "header", "sidebar"
  
  // Targeting
  targetScope String   @default("all") // "all", "agency", "agents"
  agencyId    String?  // Specific agency if targetScope = "agency"
  
  // Scheduling
  startDate   DateTime
  endDate     DateTime?
  
  // Status
  status      String   @default("draft") // "draft", "active", "paused", "expired"
  priority    Int      @default(0) // Higher = more prominent
  
  // Statistics
  impressions Int      @default(0)
  clicks      Int      @default(0)
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  adImpressions AdImpression[]
}

// AdImpression model - tracks each impression and click
model AdImpression {
  id              String   @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  
  // Viewer info
  userId          String?  // Logged-in user who viewed
  agencyId        String?  // Agency of the viewer
  userRole        String?  // Role of the viewer
  
  // Action
  action          String   // "impression" or "click"
  
  // Context
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime @default(now())
}

// BlogPost model - internal blog for agencies
model BlogPost {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  content       String   // HTML content from rich editor
  excerpt       String?  // Short summary
  coverImage    String?  // URL to cover image
  
  // Categorization
  category      String   @default("actualites") // "actualites", "conseils", "hajj", "mises_a_jour"
  
  // Publishing
  status        String   @default("draft") // "draft", "published"
  publishedAt   DateTime?
  
  // Author
  authorId      String?
  author        User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  
  // Metrics
  views         Int      @default(0)
  
  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  blogViews     BlogView[]
}

// BlogView model - track article views
model BlogView {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  // Viewer info
  userId      String?
  agencyId    String?
  
  // Context
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
}

// SystemLog model - centralized system logging for monitoring
model SystemLog {
  id        String   @id @default(cuid())
  level     String   // "info" | "warn" | "error" | "fatal"
  message   String
  source    String   // ex: "api/activate", "diagnostic", "chatbot"
  metadata  String?  // JSON string with contextual data (sanitized)
  createdAt DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([createdAt])
}

// Checklist model - public travel inventory checklists generated by passengers
// Each checklist is identified by a 6-char public code (URL: /checklist/[code])
// and protected by an 8-char verification key required to view the PDF content.
model Checklist {
  id              String   @id @default(cuid())
  // Public 6-char code (base32, no I/O/0/1) — used in URL /checklist/[code]
  code            String   @unique
  // 8-char verification key required to view/download the PDF
  verificationKey String
  // Passenger info
  firstName       String
  lastName        String
  email           String
  departureDate   String   // ISO date string (yyyy-mm-dd) — kept as string for simplicity
  destinationCountry String
  airline         String?
  // Selected items (JSON array of {category, name, qty, checked})
  items           String   // JSON string
  itemsCount      Int      @default(0)
  // Photo upload
  photoPath       String?  // Path to uploaded suitcase photo on disk
  photoSizeBytes  Int?     @default(0)
  // PDF generation metadata
  pdfPath         String?  // Optional on-disk path; null = generate on-demand
  pdfSizeBytes    Int?     @default(0)
  // Tracking
  viewCount       Int      @default(0)
  lastViewedAt    DateTime?
  emailSent       Boolean  @default(false)
  emailSentAt     DateTime?
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
  @@index([email])
  @@index([createdAt])
}

// Review model - user reviews/testimonials for social proof
model Review {
  id          String   @id @default(cuid())
  name        String   // Reviewer name (public)
  location    String?  // City/country
  rating      Int      // 1-5 stars
  title       String?  // Short title
  content     String   // Review text
  baggageRef  String?  // Optional reference to the baggage
  isFeatured  Boolean  @default(false) // Show on landing page
  isApproved  Boolean  @default(false) // Admin must approve
  response    String?  // Admin reply
  language    String   @default("fr") // "fr" | "en" | "ar"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isApproved])
  @@index([isFeatured])
  @@index([createdAt])
}

// LossAlert model - proactive loss detection alerts
model LossAlert {
  id          String   @id @default(cuid())
  baggageId   String
  reference   String   // Denormalized for quick lookup
  alertType   String   @default("no_scan_after_arrival") // "no_scan_after_arrival" | "no_scan_duration"
  message     String
  dismissed   Boolean  @default(false)
  dismissedAt DateTime?
  createdAt   DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
//  PASS IDENTITY — Pilgrim bracelet models (NEW, isolated)
// ═══════════════════════════════════════════════════════════════

// Pilgrim model - Pass Identity bracelet wearer
model Pilgrim {
  id               String   @id @default(cuid())
  qrCode           String   @unique // ex: "PH-P-3M8N5"
  fullName         String
  firstName        String?  // Prénom
  lastName         String?  // Nom de famille
  nationality      String
  language         String?  // Langue parlée (ex: "Français", "Arabe", "Wolof")
  photoUrl         String?
  bloodType        String?  // "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"
  allergies        String?  // Allergies spécifiques
  diseases         String?  // Maladies chroniques
  medicalInfo      String?  // Autres infos médicales (médicaments, etc.)
  address          String?  // Adresse du pèlerin
  phone            String?  // Numéro de téléphone du pèlerin
  hotelMecca       String?  // Hotel name in Mecca
  roomMecca        String?  // Room number in Mecca
  hotelMedina      String?  // Hotel name in Medina
  roomMedina       String?  // Room number in Medina
  hotelCoords      Json?    // { lat: number, lng: number }
  hotelAddress     String?  // Adresse de l'hôtel
  hotelPhone       String?  // Téléphone de l'hôtel (ex: "+966 12 557 0000")
  groupLeaderPhone String?  // WhatsApp number of group leader
  agencyPhone      String?  // Agency contact number
  familyContact    String?  // Family emergency contact
  hajjStage        String?  // Current Hajj journey stage key (see hajj-stages.ts)
  alNusukDocUrl    String?  // AlNusuk/Visa document link
  isActive         Boolean  @default(false) // Activated by owner
  duration         String   @default("30d") // "15d" | "30d" | "1y"
  expiresAt        DateTime?
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  agencyId         String?  // Direct link to agency (set at generation time)
  agency           Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  groupId          String?  // Group assignment for PWA leader
  group            PilgrimGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tripId           String?  // Trip assignment
  trip             Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  reports          PilgrimReport[]
  leaderScans      LeaderScan[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([qrCode])
  @@index([isActive])
  @@index([createdAt])
  @@index([agencyId])
  @@index([tripId])
  @@index([groupId])
}

// PilgrimReport model - someone found/reported a pilgrim in need
model PilgrimReport {
  id          String   @id @default(cuid())
  pilgrimId   String
  pilgrim     Pilgrim  @relation(fields: [pilgrimId], references: [id], onDelete: Cascade)
  finderName  String
  finderPhone String
  latitude    Float?
  longitude   Float?
  message     String?
  createdAt   DateTime @default(now())

  @@index([pilgrimId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
//  PASSHAJJ MANAGER PWA — Trip, Group, LeaderScan models (NEW)
// ═══════════════════════════════════════════════════════════════

// Trip model - a pilgrimage trip managed by an agency
model Trip {
  id            String        @id @default(cuid())
  name          String        // ex: "Hajj 2025 - Groupe 12"
  agencyId      String
  agency        Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  otp           String        @unique // 4-digit OTP for leader PWA login
  otpExpiry     DateTime      // When the OTP expires
  isUsed        Boolean       @default(false) // Whether OTP has been used (one-time optional)
  status        String        @default("active") // "active" | "completed" | "cancelled"
  departureDate DateTime?     // Trip departure date
  returnDate    DateTime?     // Trip return date
  destination   String?       // ex: "La Mecque"
  transportMode String        @default("flight") // "flight" | "bus" | "boat" | "train"
  // Trip stats (denormalized for quick access)
  totalPilgrims Int           @default(0)
  totalBags     Int           @default(0)
  // Relations
  pilgrims      Pilgrim[]
  bags          Bag[]
  groups        PilgrimGroup[]
  leaderScans   LeaderScan[]
  incidents     LeaderIncident[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([agencyId])
  @@index([otp])
  @@index([status])
  @@index([createdAt])
}

// PilgrimGroup model - groups of pilgrims within a trip
model PilgrimGroup {
  id          String    @id @default(cuid())
  name        String    // ex: "Groupe 1", "Groupe A"
  leaderName  String?   // Name of the group leader
  leaderPhone String?   // WhatsApp number of group leader
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tripId      String?
  trip        Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  pilgrims    Pilgrim[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([agencyId])
  @@index([tripId])
}

// Bag model - luggage items linked to a trip (PWA-specific, separate from main Baggage)
model Bag {
  id              String    @id @default(cuid())
  qrCode          String    @unique // ex: "BG-12340011"
  ownerName       String    // Name of the bag owner
  ownerId         String?   // Links to Pilgrim.id
  airline         String?   // Airline name
  flightNumber    String?   // Flight number
  destination     String?   // Destination city
  departureDate   DateTime? // Departure date
  photoUrl        String?   // Bag photo
  hotelName       String?   // Hotel in Saudi Arabia
  roomNumber      String?   // Hotel room
  baggageType     String    @default("cabine") // "cabine" | "soute"
  baggageIndex    Int       @default(1) // 1, 2, 3 (order within set)
  agencyId        String?
  agency          Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  tripId          String?
  trip            Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  leaderScans     LeaderScan[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([qrCode])
  @@index([agencyId])
  @@index([tripId])
}

// LeaderScan model - scan records from the PWA (offline-capable)
model LeaderScan {
  id          String    @id @default(cuid())
  qrCode      String    // The scanned QR code value
  type        String    // "identity" | "baggage"
  tripId      String
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  zone        String    // "Aéroport" | "Bus" | "Hôtel" | "Haram"
  timestamp   DateTime  // When the scan happened (client-side time for offline)
  status      String    @default("success") // "success" | "error" | "duplicate"
  pilgrimName String?   // Name of the scanned person/bag owner
  pilgrimId   String?   // Links to Pilgrim
  pilgrim     Pilgrim?  @relation(fields: [pilgrimId], references: [id], onDelete: SetNull)
  bagId       String?   // Links to Bag
  bag         Bag?      @relation(fields: [bagId], references: [id], onDelete: SetNull)
  synced      Boolean   @default(true) // true if synced from PWA, false if pending
  syncedAt    DateTime? // When it was synced to server
  createdAt   DateTime  @default(now())

  @@index([tripId])
  @@index([qrCode])
  @@index([timestamp])
  @@index([synced])
}

// LeaderIncident model - incidents reported by group leaders
model LeaderIncident {
  id            String    @id @default(cuid())
  type          String    // "pilgrim_sick" | "bag_damaged" | "bag_lost" | "pilgrim_missing" | "other"
  description   String    // What happened
  relatedQrCode String?   // QR code of the related item/person
  relatedName   String?   // Name of the related person
  tripId        String
  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  zone          String    // Zone where incident occurred
  timestamp     DateTime  // When it happened
  synced        Boolean   @default(true) // true if synced from PWA
  syncedAt      DateTime? // When it was synced
  createdAt     DateTime  @default(now())

  @@index([tripId])
  @@index([timestamp])
  @@index([synced])
}
